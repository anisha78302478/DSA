import java.util.Scanner;
class Node{
    Node prev;
    int data;
    Node next;
    Node head=null,tail=null;
    
    Node(Node prev,int data,Node next){
        this.prev = prev;
        this.data = data;
        this.next = next;
    }
    Node(){
        
    }
    
    void insertData(Scanner in){
        System.out.println("Enter the number of data: ");
        int n = in.nextInt();//5
        for(int i=0;i<n;i++){
            int val  = in.nextInt();
            Node obj = new Node(null,val,null);
            if(head==null){
                head = obj;
            }
            else{
                obj.prev=tail;
                tail.next = obj;
            }
            tail = obj;
        }
    }
    void displayData(){
    Node temp = head;
	while(temp!=null){
	    System.out.println(temp.data);
	    temp = temp.next;
	}
    }
    
    void insertNode(Scanner in){
        System.out.println("enter a position to insert:");
        int pos = in.nextInt();
        System.out.println("enter a value to insert:");
        int val = in.nextInt();
        Node newNode = new Node(null,val,null);
        if(pos==1){
            newNode.next = head.next.prev;
            head = newNode;
            newNode.prev = head;
        }
        else{
        Node temp = head;
        for(int i=0;i<pos-2;i++){
           temp = temp.next;
        }
        if(temp.next==null){
           tail = newNode;
       }
        newNode.next=temp.next;
        temp.next = newNode;
        temp.next.prev = newNode;
        newNode.prev = temp;
        }
      //  Node temp = head;
     //	while(temp!=null){
	//   System.out.println(temp.data);
   //   temp = temp.next;
    }
    void delete(Scanner in){
      System.out.println("Enter a position to delete:");
      int pos = in.nextInt();
      if(pos==1){
          head = head.next;
      }
      else{
          Node temp = head;
          for(int i=0;i<pos-2;i++){
           temp = temp.next;   
          }
          if(temp.next.next==null){
              tail = temp; 
          }
          
          temp.next = temp.next.next;
      }
    }
      void displayDataRev(){
    Node temp = tail;
	while(temp!=null){
	    System.out.println(temp.data);
	    temp = temp.prev;
	}
    }
}
public class Main
{
	public static void main(String[] args) {
		Node n = new Node();
		Scanner in = new Scanner(System.in);
		while(true){
		    System.out.println("1)Insert a data");
		    System.out.println("2)Display data");
		    System.out.println("3)Reverse the data");
		    System.out.println("4)Insert a new node");
		    System.out.println("5)Delete a node");
		    System.out.println("Enter your choice:");
		    int choice = in.nextInt();
		    switch(choice){
		        case 1:{
		            n.insertData(in);
		            break;
		        }
		        case 2:{
		            n.displayData();
		            break;
		        } 
		        case 3:{
		          	n.displayDataRev();
		          	break;
		        }
		        case 4:{
		            n.insertNode(in);
		            n.displayData();
		            break;
		        }
		        case 5:{
		             n.delete(in);
	                 n.displayData();
	                 break;
		        }
		    }
		    
		}
		
	}
}
